{
  "name": "dsh-bulletin-panel",
  "version": "0.3.33",
  "type": "module",
  "description": "办公室侧边栏面板：在右侧栏看公告与投递状态；公告可由用户在这里发布、编辑（投递状态只读）。权威文件仍在 00-通用\\。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/southsnowL/dsh-bulletin.git",
    "directory": "plugins/dsh-bulletin-panel"
  },
  "homepage": "https://github.com/southsnowL/dsh-bulletin#readme",
  "bugs": {
    "url": "https://github.com/southsnowL/dsh-bulletin/issues"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "meta": {
    "title": "办公室面板",
    "description": "把办公室公告与跨桌投递做成右侧栏卡片；公告可以在这里发布和编辑。"
  }
}
